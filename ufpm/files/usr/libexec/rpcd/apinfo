#!/bin/sh
# shellcheck shell=ash

BASEPATH="/tmp/apinfo"
T=$(uci -q get apinfo.@global[0].path)
[ -n "$T" ] && BASEPATH="$T"
mkdir -p "$BASEPATH"

# shellcheck source=/dev/null
. /lib/functions.sh
# shellcheck source=/dev/null
. /usr/share/libubox/jshn.sh

# Emit one host JSON object to stdout.
# jshn builds all scalar fields; the raw agent data file is spliced in
# after json_dump by replacing the sentinel string "__APINFO_DATA__".
# Called once per configured host by show_status.
show_host_json() {
	local cfg="$1"

	local enabled name ipaddr port
	config_get_bool enabled "$cfg" enabled 1
	config_get name "$cfg" name
	config_get ipaddr "$cfg" ipaddr
	config_get port "$cfg" port 22

	local lastcontact=-1
	local datafile=""

	if [ -s "${BASEPATH}/${ipaddr}-${cfg}" ] && [ "$enabled" = "1" ]; then
		local filemodtime now
		filemodtime=$(date +%s -r "${BASEPATH}/${ipaddr}-${cfg}")
		now=$(date +%s)
		lastcontact=$(( now - filemodtime ))
		datafile="${BASEPATH}/${ipaddr}-${cfg}"
	fi

	local device_status="unknown"
	if [ -f "${BASEPATH}/${ipaddr}-${cfg}-device" ]; then
		device_status=$(cat "${BASEPATH}/${ipaddr}-${cfg}-device")
	fi

	json_init
	json_add_string "section" "$cfg"
	json_add_boolean "enabled" "$enabled"
	json_add_string "name" "$name"
	json_add_string "ipaddr" "$ipaddr"
	json_add_int "port" "$port"
	json_add_int "lastcontact" "$lastcontact"
	json_add_string "device_status" "$device_status"
	json_add_string "data" "__APINFO_DATA__"

	# json_dump produces the object; replace the sentinel with the real
	# agent JSON fragment (or null when no data file is available).
	if [ -n "$datafile" ]; then
		json_dump | sed "s|\"__APINFO_DATA__\"|$(cat "$datafile")|"
	else
		json_dump | sed 's|"__APINFO_DATA__"|null|'
	fi
}

show_activity() {
	read -r input
	json_load "$input"
	json_get_var section section

	json_init

	# section is set by json_get_var above
	# shellcheck disable=SC2154
	ipaddr=$(uci_get "apinfo" "$section" "ipaddr" "")
	enabled=$(uci_get "apinfo" "$section" "enabled" "0")
	json_add_array "activity"
	if [ -n "$ipaddr" ] && [ -s "${BASEPATH}/${ipaddr}.txt" ] && [ "$enabled" = "1" ]; then
		while read -r LINE; do
			# Word splitting is intentional here to parse timestamp and value
			# shellcheck disable=SC2086
			set -- $LINE
			json_add_object
			json_add_int "timestamp" "$1"
			json_add_int "value" "$2"
			json_close_object
		done < "${BASEPATH}/${ipaddr}.txt"
	fi
	json_close_array
	json_dump
}

show_scripts() {
	json_init
	json_add_array "scripts"
	for FILE in /usr/share/apinfo/scripts/*; do
		[ -f "$FILE" ] || continue
		DESC=$(awk '/^#desc:/{gsub("#desc:", "");print $0}' "$FILE" | head -n1)
		grep -q "^#warn" "$FILE" && WARN=1 || WARN=0
		FILE_NAME=$(basename "$FILE")
		json_add_object
		json_add_string "file" "$FILE_NAME"
		json_add_string "description" "${DESC:-$FILE_NAME}"
		json_add_int "warn" "$WARN"
		json_close_object
	done
	json_close_array
	json_dump
}

show_status() {
	local _hosts_json="" _sep=""

	# config_foreach calls the function directly (no subshell), so
	# _hosts_json is visible and writable by the callback below.
	# show_host_json uses $() internally for the sed substitution, so its
	# json_init runs in a subshell and does not clobber any outer state.
	config_load apinfo
	config_foreach _show_host_collect host

	printf '{"hosts":[%s]}\n' "$_hosts_json"
}

_show_host_collect() {
	local obj
	obj=$(show_host_json "$1")
	_hosts_json="${_hosts_json}${_sep}${obj}"
	_sep=","
}

case "$1" in
	list)
		json_init

		json_add_object "activity"
		json_add_string "section" ""
		json_close_object

		json_add_object "scripts"
		json_close_object

		json_add_object "status"
		json_close_object

		json_dump
		;;
	call)
		case "$2" in
			activity)
				show_activity
				;;
			scripts)
				show_scripts
				;;
			status)
				show_status
				;;
		esac
		;;
esac

exit 0
